 /* JS Job support */
+/* A host may carry opaque state across each queued job. release is called
+   after execution or when the runtime discards pending jobs. */
+typedef void *JSJobContextCapture(JSContext *ctx, void *opaque);
+typedef void JSJobContextEnter(JSContext *ctx, void *job_context, void *opaque);
+typedef void JSJobContextLeave(JSContext *ctx, void *job_context, void *opaque);
+typedef void JSJobContextRelease(JSRuntime *rt, void *job_context, void *opaque);
+JS_EXTERN void JS_SetJobContextHooks(JSRuntime *rt,
+    JSJobContextCapture *capture, JSJobContextEnter *enter,
+    JSJobContextLeave *leave, JSJobContextRelease *release, void *opaque);
 
 typedef JSValue JSJobFunc(JSContext *ctx, int argc, JSValueConst *argv);
