{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "baseUrl": ".",
    "paths": {
      "std:ffi": ["std/ffi/index.ts"],
      "std:ffi/c": ["std/ffi/c.ts"],
      "std:fs": ["std/fs/index.ts"],
      "std:http": ["std/http/index.ts"],
      "std:plot": ["std/plot/index.ts"],
      "std:process": ["std/process/index.ts"],
      "std:runtime": ["std/runtime/index.ts"],
      "std:test": ["std/test/index.ts"],
      "std:util": ["std/util/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "std/**/*.d.ts",
    "std/runtime/index.ts",
    "std/fs/index.ts",
    "std/process/index.ts",
    "std/http/index.ts",
    "std/util/index.ts",
    "std/plot/index.ts",
    "std/ffi/index.ts",
    "std/ffi/c.ts",
    "std/test/index.ts"
  ]
}
